#: ../plugin.py:726 ../web.py:460
msgid "Do not post the link or a screenshot of it in public forums: everybody who has it can try to join and sees the terminals until you deny the access."
msgstr "Poste den Link oder einen Screenshot davon nicht in öffentlichen Foren: Jeder, der den Link kennt, kann versuchen dieser Session beizutreten."

#: ../plugin.py:874
#, python-format
msgid "Do you really want to delete all %d session logs?"
msgstr "Willst du wirklich alle %d Session-Logs löschen?"

#: ../web.py:486
msgid "Do you really want to delete all session logs and their screenshots? The log of a running session is kept."
msgstr "Willst du wirklich alle Session-Logs und ihre Screenshots löschen? Das Log einer laufenden Session bleibt erhalten."

#: ../plugin.py:866 ../web.py:485
#, python-format
