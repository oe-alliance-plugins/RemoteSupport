#: ../web.py:462
msgid "Nobody"
msgstr "Niemand"

#: ../plugin.py:428
#, python-format
msgid "Nobody used the remote support session for %d minutes. Do you want to end it?"
msgstr "Die Remote-Support-Session wurde %d Minuten lang nicht benutzt. Willst du sie beenden?"

#: ../web.py:463
#, python-format
msgid "Nobody uses the session, it ends in %d minutes."
msgstr "Niemand nutzt die Session, sie endet in %d Minuten."

#: ../web.py:477
msgid "Normal size"
msgstr "Normale Größe"

#: ../plugin.py:1026
msgid "Open a new terminal for the supporter"
msgstr "Ein neues Terminal für den Supporter öffnen"

#: ../plugin.py:404
msgid "Open a terminal first, the screenshot is shown there."
msgstr "Öffne zuerst ein Terminal, der Screenshot wird dort angezeigt."

#: ../web.py:467
msgid "Open the session"
msgstr "Session öffnen"

#: ../web.py:469
msgid "Open the session in its own tab, the new user has to be approved as well."
msgstr "Session in einem eigenen Tab öffnen, der neue Benutzer muss ebenfalls freigegeben werden."

#: ../plugin.py:714
msgid "Press GREEN to start a support session. You will get a link and a QR code for your supporter, who then gets a terminal on this receiver in their web browser."
msgstr "GRÜN startet eine Support-Session. Du bekommst einen Link und einen QR-Code für deinen Supporter, der dann im Webbrowser ein Terminal auf diesem Receiver starten kann."

