msgstr "Verbindung zum sshx-Server wird aufgebaut, bitte warten."

#: ../plugin.py:829 ../web.py:481
msgid "Delete"
msgstr "Löschen"

#: ../plugin.py:831 ../web.py:482
msgid "Delete All"
msgstr "Alle löschen"

#: ../plugin.py:796
msgid "Delete all session logs except the one of a running session"
msgstr "Alle Session-Logs löschen, außer dem einer laufenden Session"

#: ../plugin.py:793
msgid "Delete the selected session log"
msgstr "Das gewählte Session-Log löschen"

#: ../web.py:455
msgid "Deny"
msgstr "Ablehnen"

#: ../plugin.py:721 ../web.py:460
msgid "Do not post the link or a screenshot of it in public forums: everybody who has it can try to join and sees the terminals until you deny the access."
msgstr "Poste den Link oder einen Screenshot davon nicht in öffentlichen Foren: Jeder, der den Link kennt, kann versuchen dieser Session beizutreten."

#: ../plugin.py:868
#, python-format
msgid "Do you really want to delete all %d session logs?"
msgstr "Willst du wirklich alle %d Session-Logs löschen?"

#: ../web.py:486
msgid "Do you really want to delete all session logs and their screenshots? The log of a running session is kept."
msgstr "Willst du wirklich alle Session-Logs und ihre Screenshots löschen? Das Log einer laufenden Session bleibt erhalten."

#: ../plugin.py:860 ../web.py:485
#, python-format
msgid "Do you really want to delete the session log '%s' and its %d screenshots?"
msgstr "Willst du das Session-Log '%s' und seine %d Screenshots wirklich löschen?"

#: ../plugin.py:858 ../web.py:484
#, python-format
msgid "Do you really want to delete the session log '%s' and its screenshot?"
msgstr "Willst du das Session-Log '%s' und seinen Screenshot wirklich löschen?"

#: ../plugin.py:862 ../web.py:483
#, python-format
msgid "Do you really want to delete the session log '%s'?"
msgstr "Willst du das Session-Log '%s' wirklich löschen?"

#: ../plugin.py:735 ../web.py:490
msgid "Do you really want to end the support session?"
msgstr "Willst du die Support-Session wirklich beenden?"

#: ../plugin.py:354
msgid "Do you want to allow the access? Then the supporter can open terminals on this receiver."
msgstr "Willst du den Zugriff erlauben? Dann kann der Supporter Terminals auf diesem Receiver öffnen."

#: ../plugin.py:1201
#, python-format
msgid "Do you want to close terminal %d? The supporter loses it together with everything running in it."
msgstr "Willst du Terminal %d schließen? Der Supporter verliert es samt allem, was darin läuft."

#: ../plugin.py:737 ../web.py:489
msgid "Do you want to start a support session?"
msgstr "Willst du eine Support-Session starten?"

